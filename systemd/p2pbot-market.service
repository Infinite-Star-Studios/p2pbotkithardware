# Runs the p2pbotkit market bot on mainnet as a service: starts at boot,
# restarts after a crash. See ../README.md, "Run it as a service".
#
# Before enabling it, run `sh start.sh mainnet` once by hand as the p2pbot
# user (it makes the keys and market.mainnet.json and shows a dry run), add
# your offers, fund the addresses and check `sh start.sh mainnet dry-run`.
# Started from here it has no terminal, so start.sh takes KIT_ALLOW_MAINNET=1
# in place of the typed yes and skips the dry run: it trades at once.
#
# Layout assumed: user p2pbot, kit in /srv/p2pbot/p2pbotkit, where
# /srv/p2pbot is a plain folder or the mount point of an encrypted volume.

[Unit]
Description=Saturn P2P market bot (p2pbotkit, mainnet)
Documentation=https://github.com/Infinite-Star-Studios/p2pbotkit
Wants=network-online.target
# The kit refuses to sign when the clock is more than 300 s off Base, so wait
# for network time (enable systemd-time-wait-sync.service for this to hold).
After=network-online.target time-sync.target
# Skip, rather than fail, while the kit's folder is not there, e.g. while its
# encrypted volume is still locked after a reboot.
ConditionPathExists=/srv/p2pbot/p2pbotkit/start.sh

[Service]
Type=simple
User=p2pbot
Group=p2pbot
WorkingDirectory=/srv/p2pbot/p2pbotkit
Environment=KIT_ALLOW_MAINNET=1
Environment=KIT_STORE_KEY_FILE=/srv/p2pbot/p2pbotkit/keys/store.key
ExecStart=/bin/sh /srv/p2pbot/p2pbotkit/start.sh mainnet
StandardInput=null

# Stopping: SIGTERM to the bot alone is the kit's clean stop (Ctrl-C once):
# it cancels its offers and finishes running trades, which on mainnet can take
# hours. After TimeoutStopSec systemd kills it (Ctrl-C twice). The kit's state
# is crash-safe and the next start resumes every trade, but a stopped bot sends
# no locks, claims or refunds, so do not leave it stopped.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=15min
Restart=on-failure
RestartSec=30s

# Hardening. The bot only needs to write its own folder and the user's home
# (npm's cache). Do not add MemoryDenyWriteExecute: Node's JIT needs it off.
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/srv/p2pbot /home/p2pbot
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
